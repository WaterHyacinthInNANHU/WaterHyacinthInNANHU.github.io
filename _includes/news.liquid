<div class="news">
  {% assign news = site.news | sort: 'date' | reverse %}
  {% assign recent_rows = '' -%}
  {%- assign older_rows = '' %}
  {% for item in news %}
    {% capture news_row %}
      <tr><th scope="row">{{ item.date | date: '%b %Y' }}</th><td>
        {% if item.category %}<span class="news-category news-category-{{ item.category | downcase }}">{{ item.category }}</span>{% endif %}
        {% if item.inline %}{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}{% else %}<a href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}
      </td></tr>
    {% endcapture %}
    {% if include.limit and forloop.index > 3 -%}
      {%- assign older_rows = older_rows | append: news_row -%}
    {%- else -%}
      {%- assign recent_rows = recent_rows | append: news_row -%}
    {%- endif %}
  {% endfor %}
  {% if news.size > 0 %}
    <table class="table table-sm table-borderless">
      <tbody>
        {{ recent_rows }}
      </tbody>
    </table>
    {% if older_rows != '' %}
      <details class="older-news">
        <summary><span class="news-show">Show older news</span><span class="news-hide">Hide older news</span></summary>
        <table class="table table-sm table-borderless">
          <tbody>
            {{ older_rows }}
          </tbody>
        </table>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
